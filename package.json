{
  "name": "joblens",
  "version": "0.1.0-alpha.13",
  "private": false,
  "type": "module",
  "description": "Open-source AI workflow for discovering, researching, ranking, and preparing job applications across multiple sources.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "joblens": "dist/cli/bin.js",
    "joblens-mcp": "dist/mcp/bin.js"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/unit/*.test.mjs",
    "joblens": "npm run build --silent && node dist/cli/bin.js",
    "mcp": "npm run build --silent && node dist/mcp/bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "typescript": "^5.8.3",
    "@types/node": "^22.0.0"
  }
}
